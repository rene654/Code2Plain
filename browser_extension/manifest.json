{
  "manifest_version": 3,
  "name": "Code2Plain Learning Layer",
  "version": "0.1.0",
  "description": "Learn what AI-generated code does while you build.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "css": [
        "code2plain.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
