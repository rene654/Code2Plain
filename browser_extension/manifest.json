{
  "manifest_version": 3,
  "name": "Code2Plain Learning Layer",
  "version": "0.1.0",
  "description": "Learn what AI-generated code does while you build.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.app.github.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": []
}
